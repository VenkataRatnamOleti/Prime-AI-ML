# Filtering of Data

df[ (df["aqi"] > 100) & (df["temperature"] > 30) ]
df[ (df["aqi"] > 100) & (df["temperature"] < 30) ]


aqi_data = df[ (df["aqi"] > 100) & (df["temperature"] > 30) ][["city","aqi"]]

aqi_data
aqi_data.iloc[0]
aqi_data.loc[6]


# filtering data using query

# Query
df.query("aqi>100")

# Rules
# 1. Expressed as a string
# 2. Column based reference
# 3. Backticks for col_name with space or special chars
# 4. Operators (&, |, ~, >=, >, <=, <, == etc.)
# 5. @ to reference Python vars
# 6. Chained comparisons

df.query("aqi>100 & temperature > 30")[["city","aqi"]]


aqi_val = 100
df.query("aqi > @aqi_val & temperature > 30")[["city","aqi"]]


# query returns copy. not view.


# Data Cleaning

# Handle Missing Values.

# - isnull()                #NaN -> Not a Null
# - isnull() / isna() (alias)  ->roots in R
# - isnull().sum()
# - dropna()
# - fillna(value)
# - ffill()
# - bfill()


df = pd.read_csv("raw_data.csv")


df


df.isnull()
df.isna()


df.isnull().sum()


df.dropna() #rows

df.dropna(axis=1)



df.fillna(0)
df.fillna(100)

age_mean = df["age"].mean()

cleaned_data = df.copy()
cleaned_data["age"] = cleaned_data["age"].fillna(age_mean)


cleaned_data



# ffill() ---> forward fill

df.ffill()


# bfill() --> backward fill

df.bfill()


df


