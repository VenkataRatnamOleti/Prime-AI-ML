import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.impute import SimpleImputer
from sklearn.model_selection import train_test_split


df = pd.read_csv("loan_approval_data.csv")


df.head()
df.info()
df.isnull().sum()
df.describe()





# numerical value ---> replace with mean. (median is less used)
# categorial value ---> replace with mode


categorical_cols = df.select_dtypes(include=["object"]).columns
numerical_cols = df.select_dtypes(include=["float64"]).columns #int64,number


categorical_cols


numerical_cols


# to impute the numerical data
num_imp = SimpleImputer(strategy="mean")
df[numerical_cols] = num_imp.fit_transform(df[numerical_cols])


df[numerical_cols].isnull().sum()


# to impute the caterogial data
cat_imp = SimpleImputer(strategy="most_frequent")
df[categorical_cols] = cat_imp.fit_transform(df[categorical_cols])


df.isnull().sum()





# How balanced our classes are ?
classes_count = df["Loan_Approved"].value_counts()
plt.pie(classes_count, labels=["No","Yes"], autopct="%1.1f%%")
plt.title("Is Loan approved or not")


# analyze categories

# gender_cnt = df["Gender"].value_counts()
# ax = sns.barplot(gender_cnt)
# ax.bar_label(ax.containers[0])

edu_cnt = df["Education_Level"].value_counts()
ax = sns.barplot(edu_cnt)
ax.bar_label(ax.containers[0])


for category in categorical_cols:
    category_df = df[category].value_counts()
    ax = sns.barplot(category_df)
    ax.bar_label(ax.containers[0])

    plt.title(f"Distribution of {category}", fontweight="bold")
    plt.xticks(rotation=30) 
    plt.show()



