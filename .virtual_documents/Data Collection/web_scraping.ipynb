from bs4 import BeautifulSoup

with open("scraped_data/data1.html","r") as f:
    html_content = f.read()

soup = BeautifulSoup(html_content,"lxml")


soup

# Methods
# 1. find()    -> first matching element
# 2. find_all()
# 3. find_parent()
# 4. find_next()
# 5. find_previous()




soup.find("h1")
soup.find("h3")

soup.h1


all_h3 = soup.find_all("h3")
type(all_h3)  # exactly like a list

for h3 in all_h3:
    print(h3.get_text(strip=True))

# get_text()


all_h3 = soup.find_all("h3")
all_countries = []
for h3 in all_h3:
    name = h3.get_text(strip=True)
    # print(h3.find_parent("div")["class"])
    # find_next() -> used for next, next
    # find_previous() -> used for previous elements
    population = h3.find_next("div").select_one("span.country-population").get_text(strip=True)
    # print(h3.attrs)
    all_countries.append([name,population])
# CSS SELECTORS
  # 1. select()
  # 2. select_one()

# ATTRIBUTES
  # 1. get()
  # 2. .attrs


# all_countries

import pandas as pd

df = pd.DataFrame(all_countries,columns=["Name","Population"])
# df


df.to_csv("cleaned_data/data.csv",index=False)






