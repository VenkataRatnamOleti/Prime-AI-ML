# Merging & Joining Data
# 1. inner join
# 2. left join
# 3. right join
# 4. outer join

# pandas.Merging == sql.joins

df_customers = pd.DataFrame({
    "customer_id": [1,2,3,4],
    "name": ["Adam","Bob","Charlie","Dave"]
})

df_orders = pd.DataFrame({
    "order_id":[101,102,103,104],
    "customer_id":[2,1,4,5],
    "amount":[250,120,300,180]
})


df_customers


df_orders


pd.merge(df_customers,df_orders,on="customer_id") #inner join (common)
pd.merge(df_customers,df_orders,on="customer_id", how="left") #left join (common)
pd.merge(df_customers,df_orders,on="customer_id", how="right") #right join (common)
pd.merge(df_customers,df_orders,on="customer_id", how="outer") #outer join (common)


# Data Concatenation in Pandas
# Stacking DataFrames on top of each other (rows) or side by side (columns).

df1 = pd.DataFrame({
    "id":[1,2,3],
    "name":["Adam","Eve","Bob"]
})

df2 = pd.DataFrame({
    "id":[4,5,6],
    "name":["Charlie","Fester","Gilian"]
})


df1


df2


pd.concat([df1,df2]) # row wise
pd.concat([df1,df2],ignore_index=True)

pd.concat([df1,df2],axis=1) # col wise




