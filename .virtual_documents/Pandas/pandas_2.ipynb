# Feature Engineering




import pandas as pd


df = pd.read_csv("raw_data.csv")


df


df2 = df.copy()

df2["Tax"] = df2["income"].apply(lambda x: "20%" if x>= 50000 else "10%")
df2


# apply() is a Higher Order Function (HOF)

# map() -> dictionary is required


gender_map = { "Male" : "M", "Female" : "F", "Unknown" : "U"}
df2['gender'] = df2["gender"].map(gender_map)
df2


# assign()

df2.assign(new_income = df2["income"]* 1.1)


# replace(old, new)

df2["country"] = df2["country"].replace("USA","US")
df2 


# 1. rename(columns={old:new})
# 2. sort_values()
# 3. sort_index()
# 4. reset_index()
# 5. rank()
# 6. Reorder columns


# rename

df2.columns = ["Id","Name","Age","Country","Gender","Income","Tax"]
df2.rename(columns={"Income":"Salary"})
df2.rename(index={1:"First"})

# sort_values()

df2.sort_values("Income") # ascending=False => descending order
sorted_df = df2.sort_values(["Income","Age"])

sorted_df.sort_index()

# reset

sorted_df.reset_index()
sorted_df.reset_index(drop=True)

# rank 

sorted_df["Ranking"] = sorted_df["Income"].rank()
sorted_df

sorted_df["Ranking"] = sorted_df["Income"].rank(ascending=False, method="dense")
sorted_df

# method -> ties [dense,min,max]

# reorder columns

sorted_df[["Id","Name","Age","Gender","Income","Tax","Country"]]


# Task - shift id column to left


df2 = df.copy()
new_col_order = [col for col in df2.columns if col != "id"] +["id"]
print(new_col_order)
df2[new_col_order]


## Pandas writing to csv

# df.to_csv(file)
# to_json() to_excel()

df2 = df.copy()

df2 = df2.drop_duplicates()
df2 = df2.fillna(0)

df2 = df2.sort_values("income")
df2 = df2.reset_index(drop=True)

df2.to_csv("sorted_data.csv")


df2 



# Grouping & aggregation of Data (****Important****)

# 1. groupby()
# 2. mean/sum/max/min/count etc
# 3. agg()

df.groupby("country")["income"].mean()
df.groupby("country")["income"].min()
df.groupby("country")["income"].max()

df.groupby("gender")["income"].mean()


df.groupby("country")["income"].agg(["mean","min","max"])
df.groupby("country")["income"].aggregate(avg_sal="mean",min_sal="min",max_sal="max")


df.groupby("country").agg({
    "income":"mean",
    "age":"mean"
})

df.groupby("country").agg(
    max_sal=("income","max"),
    avg_age=("age","mean")
)


# Melt and Pivot

# 1. Melt - wide to Long format
# melt(id_vars[keep],value_vars[unpivot],var_name[new colname],value_name[new col value])

df = pd.DataFrame({
    "country":["USA","USA","India","India"],
    "year": [2020,2021,2020,2021],
    "sales": [100,120,90,110],
    "profit": [20,25,18,22],
    "tax": [10,20,30,40]
})

melted_df = df.melt(
    id_vars=["country","year"],
    value_vars=["sales","profit","tax"],
    var_name="metrics",
    value_name="value"
)


df


# 2. pivot - Long to wide format
# pivot(index[keep],columns[new cols],values[])

original = melted_df.pivot(
    index=["country","year"],
    columns="metrics",
    values="value"
)


original


