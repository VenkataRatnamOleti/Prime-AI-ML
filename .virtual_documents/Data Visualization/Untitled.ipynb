import numpy as np
import matplotlib.pyplot as plt


data = np.random.normal(loc=70,scale=10, size=200)
mean = np.mean(data)
plt.hist(data,bins=30,edgecolor="black",color="skyblue")
plt.axvline(x=mean,color="red",linestyle="dashed")


import seaborn as sns
penguins = sns.load_dataset("penguins")


sns.scatterplot(
    data=penguins,
    x="flipper_length_mm",
    y="body_mass_g",
    hue="species"
)


tips = sns.load_dataset("tips")


sns.boxplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex"
)

# sunday has the highest median bill
# there are more outliers on thursday
























