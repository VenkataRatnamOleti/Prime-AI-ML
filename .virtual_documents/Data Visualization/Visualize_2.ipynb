


import seaborn as sns
import matplotlib.pyplot as plt


sns.set_theme()


# sns.get_dataset_names()
tips = sns.load_dataset("tips")
type(tips)
print(tips.head())


# relation plot (relplot()) -> scatter plot, line plot etc,.
# sns.set_theme(style="ticks")

sns.relplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="smoker",
    size="size",
    style="smoker"
)



x_vals = [i for i in range(1,11)]
x_sq = [i**2 for i in x_vals]

sns.set_theme(style="ticks")
sns.relplot(
    x=x_vals,
    y=x_sq,
    kind="line",
)


## Relational plots in seaborn

# 1. Scatter Plots
# 2. Linr Plots


tips = sns.load_dataset("tips")

sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="time"
)


# line plot

flights = sns.load_dataset("flights")

sns.lineplot(
    data=flights,
    x="year",
    y="passengers"
)

# Shaded area
# confidence interval (ci) -> 95%
# mean + or - ci


# Categorical Plots
# 1. Bar Plots
# 2. Box Plots


# print(tips.head())

sns.barplot(
    data=tips,
    x="day",
    y="tip",
    hue="sex"
)


# Box Plot

sns.boxplot(
    data=tips,
    x="day",
    y="tip"
)


# Distribution plots

# 1. Histogram


penguins = sns.load_dataset("penguins")
# penguins.head()

sns.histplot(
    data=penguins,
    x="body_mass_g",
    bins=30
)





flights.head()


flights_pivot = flights.pivot(index="month",columns="year",values="passengers")


sns.heatmap(
    flights_pivot,
    cmap="coolwarm",
    annot=True,
    fmt="d"
)

plt.title("Passenders Heatmap")
plt.tight_layout()





# Seaborn is used for individual plot
# but if need any low level customizations then we have to use matplotlib


fig, ax = plt.subplots()

sns.lineplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex",
    marker="o",
    ax=ax,
    ci=None
)

ax.set_title("Avg bill value for each day")
ax.set_xlabel("Days")
ax.set_ylabel("Total Bill Amount")

fig.tight_layout()









