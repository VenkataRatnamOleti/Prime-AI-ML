import pandas as pd
import seaborn as sns
from sklearn.model_selection import train_test_split


insurance_data = pd.read_csv("insurance.csv")


insurance_data


#visualize
sns.scatterplot(
    x=insurance_data['bmi'],
    y=insurance_data['charges'],
    hue=insurance_data['smoker']
)


X = insurance_data.drop(columns=["charges","region"])
Y = insurance_data["charges"]

X["sex"] = X["sex"].map({"female":1,"male":0})
X["smoker"] = X["smoker"].map({"yes":1,"no":0})


X.head()


# Train Test split
X_train, X_test, Y_train, Y_test = train_test_split(X,Y,test_size=0.8,random_state=42)


X_train.head()


# Train
from sklearn.linear_model import LinearRegression

model = LinearRegression()
model.fit(X_train,Y_train)


# Predict Values
y_pred = model.predict(X_test)


y_pred


Y_test








# Model Evaluate

from sklearn.metrics import r2_score
# from sklearn.metrics import 
r2 = r2_score(Y_test, y_pred)
n = X_test.shape[0]
p = X_test.shape[1]

adjusted_r2 = 1 - ((1-r2)*(n-1)/(n-p-1))
print("r-squared :", r2)
print("adjusted r-squared :", adjusted_r2)





# One Hot Encoding

X = insurance_data.drop(columns=["charges"])
Y = insurance_data["charges"]

X = pd.get_dummies(X, columns=["region"], drop_first=True, dtype=int)
X["sex"] = X["sex"].map({"female":1,"male":0})
X["smoker"] = X["smoker"].map({"yes":1,"no":0})


X.head()


# Train Test split
X_train, X_test, Y_train, Y_test = train_test_split(X,Y,test_size=0.8,random_state=42)

model = LinearRegression()
model.fit(X_train, Y_train)
y_pred = model.predict(X_test)

r2 = r2_score(Y_test, y_pred)
n = X_test.shape[0]
p = X_test.shape[1]

adjusted_r2 = 1 - ((1-r2)*(n-1)/(n-p-1))
print("r-squared :", r2)
print("adjusted r-squared :", adjusted_r2)


## Dummy Variable Trap
# when features are interrelated

# inflated errors        ---> remove 1 redundant variable
# unstable coefficients  --/


X.sample(10)











X = insurance_data.drop(columns=["charges"])
Y = insurance_data["charges"]

X = pd.get_dummies(X, columns=["region"], drop_first=True, dtype=int)
X["sex"] = X["sex"].map({"female":1,"male":0})
X["smoker"] = X["smoker"].map({"yes":1,"no":0})

X["age_smoker"] = X["age"] * X["smoker"]
X["bmi_smoker"] = X["smoker"] * X["bmi"]


X.head()


# Train Test split
X_train, X_test, Y_train, Y_test = train_test_split(X,Y,test_size=0.8,random_state=42)

model = LinearRegression()
model.fit(X_train, Y_train)
y_pred = model.predict(X_test)

r2 = r2_score(Y_test, y_pred)
n = X_test.shape[0]
p = X_test.shape[1]

adjusted_r2 = 1 - ((1-r2)*(n-1)/(n-p-1))
print("r-squared :", r2)
print("adjusted r-squared :", adjusted_r2)








# Underfit & Overfit
# r2 training is low & r2 testing is also low - underfit
# r2 training is high & r2 testing is also low - overfit

y_train_pred = model.predict(X_train);
r2_train = r2_score(Y_train,y_train_pred)
# r2_test
print("Training data r2 : ",r2_train)
print("Testing data r2 : ",r2)



























