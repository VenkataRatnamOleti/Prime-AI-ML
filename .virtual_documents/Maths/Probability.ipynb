from scipy.stats import binom


n = 5
k = 3
p = 0.5


prob = binom.pmf(k,n,p)   # -> Binomial Distribution


print(prob)


# Uniform Distribution

import numpy as np
import matplotlib.pyplot as plt


values = np.random.uniform(0,10,10_00_000)

plt.hist(values,bins=100, density=True,alpha=0.3)

plt.title("Continuous Uniform Distribution between 0 and 10")
plt.xlabel("x")
plt.ylabel("Probabiity Density")
plt.grid(True)

plt.show()





import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm


mu = 70 # mean
sigma = 10 # std dev


x = np.linspace(30,110,1000)
y = norm.pdf(x,mu,sigma)

plt.plot(x,y,color="black",linewidth=2,label="Normal Distribution")


x1 = np.linspace(mu-sigma,mu-sigma,1000)
plt.fill_between(x1,norm.pdf(x1,mu,sigma),color="green",alpha=0.3,label="68% region (1σ)")

plt.show()



